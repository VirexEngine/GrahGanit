# GrahGanit Environment Configuration

# Gmail SMTP Configuration for Sacred Verification Codes
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_google_app_password
EMAIL_FROM=GrahGanit Observatory <your_email@gmail.com>
SMTP_TIMEOUT=10

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# PostgreSQL Database Connection URL (Optional - defaults to local SQLite grahganit.db if not provided)
# DATABASE_URL=postgresql://user:password@host:5432/grahganit_db

# Google OAuth Client ID for Google Identity Services (GIS) Sign-In
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=
